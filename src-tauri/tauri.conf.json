{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudyTracker",
  "version": "0.1.0",
  "identifier": "id.studytracker.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StudyTracker",
        "width": 1100,
        "height": 720,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Pelacak waktu belajar pribadi",
    "longDescription": "Catat sesi belajar per mata pelajaran, lihat riwayat dan statistik. Data tersimpan lokal di komputer kamu."
  }
}
